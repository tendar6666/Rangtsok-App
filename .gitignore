.agents/

# Environment, Secrets & Keys
.env
.env.*
*.key
*.pem
*.cert

# Editor & System files
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# Temporary & Backup files
*.bak
*.tmp

# User manual (uploaded as a Release asset instead)
User_Manual.pdf
